{
  "description": "Neovim is a hyper-extensible text editor derived from Vim",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "neovim.png",
  "friendly_name": "Neovim",
  "cores": 2,
  "memory": 5536,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "run_config": {
    "hostname": "kasm-neovim"
  },
  "exec_config": {
    "first_launch": {
      "user": "root",
      "cmd": "bash -c 'echo \"kasm-user  ALL=(ALL) NOPASSWD: ALL\" >> /etc/sudoers'"
    }
  },
  "categories": [
    "Development",
    "Desktop",
    "Productivity"
  ],
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "doctorwhen/kasm:neovim",
      "uncompressed_size_mb": 12700,
      "available_tags": [
        "1.17.0",
        "1.16.0",
        "1.15.0",
        "1.14.0"
      ]
    }
  ]
}