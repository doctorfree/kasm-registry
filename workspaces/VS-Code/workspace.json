{
  "description": "Visual Studio Code source-code editor",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "vscode.png",
  "friendly_name": "Visual Studio Code",
  "cores": 2,
  "memory": 4096,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "run_config": {
    "hostname": "kasm-vscode"
  },
  "exec_config": {
    "first_launch": {
      "user": "root",
      "cmd": "bash -c 'echo \"kasm-user  ALL=(ALL) NOPASSWD: ALL\" >> /etc/sudoers'"
    }
  },
  "categories": [
    "Development",
    "Desktop",
    "Productivity"
  ],
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.16.x",
      "image": "doctorwhen/kasm:vscode",
      "uncompressed_size_mb": 12900
    },
    {
      "version": "1.17.x",
      "image": "doctorwhen/kasm:vscode",
      "uncompressed_size_mb": 12900
    }
  ]
}